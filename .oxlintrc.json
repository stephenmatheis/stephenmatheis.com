{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["react", "jsx-a11y", "nextjs", "import", "typescript"],
    "categories": {
        "correctness": "error"
    },
    "env": {
        "builtin": true,
        "browser": true,
        "node": true
    },
    "ignorePatterns": [".next/**", "out/**", "build/**", "next-env.d.ts"],
    "rules": {
        "react/exhaustive-deps": "warn"
    }
}
